{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "firebase-key*.json",
      "*-firebase-adminsdk-*.json",
      "*.py",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
